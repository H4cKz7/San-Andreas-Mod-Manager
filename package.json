{
  "name": "sa-mod-manager",
  "version": "1.2.5",
  "description": "GTA San Andreas Mod Loader manager",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-packager . \"SA Mod Manager\" --platform=win32 --arch=x64 --icon=build/icon.ico --out=dist --overwrite --ignore=\"^/dist\"",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-packager": "^17.1.2",
    "rcedit": "^4.0.1"
  },
  "build": {
    "appId": "com.samm.modmanager",
    "productName": "SA Mod Manager",
    "afterPack": "afterPack.js",
    "files": [
      "main.js",
      "index.html",
      "renderer/**",
      "fsshim.js",
      "package.json",
      "build/**"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "asarUnpack": [
      "node_modules/7zip-bin/**/*",
      "node_modules/node-unrar-js/**/*"
    ]
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "node-unrar-js": "^2.0.2"
  }
}
