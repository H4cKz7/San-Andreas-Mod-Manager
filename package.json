	{
  "name": "sa-mod-manager",
  "version": "1.2.6",
  "description": "GTA San Andreas Mod Loader manager",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "build": "electron-builder",
	"installer": "electron-builder --win nsis"
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "rcedit": "^4.0.1"
  },
  "build": {
    "appId": "com.samm.modmanager",
    "productName": "SA Mod Manager",
    "afterPack": "afterPack.js",
    "files": [
      "main.js",
      "index.html",
      "renderer/**",
      "fsshim.js",
      "package.json",
      "build/**"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "asarUnpack": [
      "node_modules/7zip-bin/**/*",
      "node_modules/node-unrar-js/**/*"
    ]
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "node-unrar-js": "^2.0.2"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
